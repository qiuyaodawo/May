{
  "name": "@sortedyuan/session",
  "version": "0.5.0",
  "description": "Session lifecycle and durable history for May agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./file-store": {
      "types": "./dist/file-store.d.ts",
      "import": "./dist/file-store.js"
    },
    "./file-access": {
      "types": "./dist/file-access.d.ts",
      "import": "./dist/file-access.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "docs"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage test/*.test.mjs"
  },
  "dependencies": {
    "@sortedyuan/core": "workspace:*",
    "fs-native-extensions": "1.5.1"
  },
  "devDependencies": {
    "@sortedyuan/permissions": "workspace:*",
    "@sortedyuan/provider-openai": "workspace:*",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
