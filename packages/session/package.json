{
  "name": "@may/session",
  "version": "0.1.0",
  "description": "Session lifecycle and durable history for May agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./file-store": {
      "types": "./dist/file-store.d.ts",
      "import": "./dist/file-store.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage test/*.test.mjs"
  },
  "dependencies": {
    "@may/core": "workspace:*"
  },
  "devDependencies": {
    "@may/permissions": "workspace:*",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
