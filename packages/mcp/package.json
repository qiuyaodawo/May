{
  "name": "@sortedyuan/mcp",
  "version": "0.2.3",
  "description": "Model Context Protocol clients, isolated Apps host and opt-in server exports for May.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": { "types": "./dist/plugin/index.d.ts", "import": "./dist/plugin/index.js" },
    "./apps-browser": {
      "types": "./dist/apps-browser.d.ts",
      "import": "./dist/apps-browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm run build && node --test test/*.test.mjs test/plugin/*.test.mjs",
    "test:browser": "pnpm run build && node --test test/browser/*.test.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage test/*.test.mjs test/plugin/*.test.mjs"
  },
  "dependencies": {
    "@sortedyuan/may": "workspace:*",
    "@sortedyuan/observability": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@napi-rs/keyring": "2.0.0"
  }
}
