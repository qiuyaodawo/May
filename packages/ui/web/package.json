{
  "name": "@sortedyuan/web-ui",
  "version": "0.2.2",
  "description": "Composable browser workbench for May agents, independent of product policy.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./assets/workbench.css",
    "./assets": { "types": "./dist/assets.d.ts", "import": "./dist/assets.js" }
  },
  "files": ["dist", "assets", "!dist/.tsbuildinfo"],
  "scripts": { "build": "tsc -b", "clean": "tsc -b --clean", "test:browser": "pnpm --filter @sortedyuan/provider-openai build && pnpm run build && node --test test/browser/*.test.mjs" },
  "dependencies": { "@sortedyuan/ui-client": "workspace:*" },
  "devDependencies": { "@sortedyuan/application": "workspace:*", "@sortedyuan/provider-openai": "workspace:*", "@sortedyuan/session": "workspace:*", "@types/node": "^22.0.0", "playwright": "1.63.0" },
  "engines": { "node": ">=22" },
  "license": "MIT"
}
