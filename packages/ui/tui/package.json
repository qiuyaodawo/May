{
  "name": "@may/tui",
  "version": "0.1.0",
  "description": "May-owned retained terminal UI primitives and renderer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node-terminal": {
      "types": "./dist/node-terminal.d.ts",
      "import": "./dist/node-terminal.js"
    },
    "./list-selection": {
      "types": "./dist/list-selection.d.ts",
      "import": "./dist/list-selection.js"
    },
    "./slash-commands": {
      "types": "./dist/slash-commands.d.ts",
      "import": "./dist/slash-commands.js"
    },
    "./transcript": {
      "types": "./dist/agent/transcript.d.ts",
      "import": "./dist/agent/transcript.js"
    },
    "./tool-renderers": {
      "types": "./dist/agent/tool-renderers.d.ts",
      "import": "./dist/agent/tool-renderers.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/demo.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "demo": "pnpm run build && node dist/demo.js",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@may/coding-tools": "workspace:*",
    "@may/core": "workspace:*",
    "@may/keybindings": "workspace:*",
    "@may/permissions": "workspace:*",
    "@may/session": "workspace:*",
    "marked": "18.0.11",
    "slice-ansi": "^7.1.2",
    "string-width": "^7.2.0",
    "wrap-ansi": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
