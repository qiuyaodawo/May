{
  "name": "@sortedyuan/plugin-services",
  "version": "0.3.0",
  "description": "Typed agent services and ordered plugin contribution registries.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./models": { "types": "./dist/models.d.ts", "import": "./dist/models.js" },
    "./runtime": { "types": "./dist/runtime.d.ts", "import": "./dist/runtime.js" },
    "./permissions": { "types": "./dist/permissions.d.ts", "import": "./dist/permissions.js" },
    "./skills": { "types": "./dist/skills.d.ts", "import": "./dist/skills.js" }
  },
  "files": ["dist", "!dist/.tsbuildinfo", "docs", "README.zh-CN.md"],
  "scripts": { "build": "tsc -b", "clean": "tsc -b --clean", "test": "pnpm run build && node --test test/*.test.mjs", "test:coverage": "pnpm run build && node --test --experimental-test-coverage test/*.test.mjs" },
  "dependencies": { "@sortedyuan/core": "workspace:*", "@sortedyuan/context": "workspace:*", "@sortedyuan/plugin": "workspace:*", "@sortedyuan/permissions": "workspace:*", "@sortedyuan/session": "workspace:*", "@sortedyuan/skills": "workspace:*" },
  "devDependencies": { "@types/node": "^22.0.0" },
  "engines": { "node": ">=22" },
  "license": "MIT"
}
