{
  "name": "@sortedyuan/may",
  "version": "0.1.0",
  "description": "Composable Agent runtime, sessions, applications and plugin services.",
  "type": "module",
  "main": "./dist/application/index.js",
  "types": "./dist/application/index.d.ts",
  "exports": {
    ".": { "types": "./dist/application/index.d.ts", "import": "./dist/application/index.js" },
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./application": { "types": "./dist/application/index.d.ts", "import": "./dist/application/index.js" },
    "./application/git-workspace": { "types": "./dist/application/git-workspace.d.ts", "import": "./dist/application/git-workspace.js" },
    "./context": { "types": "./dist/context/index.d.ts", "import": "./dist/context/index.js" },
    "./context/model-summarizer": { "types": "./dist/context/model-summarizer.d.ts", "import": "./dist/context/model-summarizer.js" },
    "./session": { "types": "./dist/session/index.d.ts", "import": "./dist/session/index.js" },
    "./session/tools": { "types": "./dist/session/tools.d.ts", "import": "./dist/session/tools.js" },
    "./session/catalog": { "types": "./dist/session/catalog.d.ts", "import": "./dist/session/catalog.js" },
    "./session/file-store": { "types": "./dist/session/file-store.d.ts", "import": "./dist/session/file-store.js" },
    "./session/file-access": { "types": "./dist/session/file-access.d.ts", "import": "./dist/session/file-access.js" },
    "./storage": { "types": "./dist/storage/index.d.ts", "import": "./dist/storage/index.js" },
    "./permissions": { "types": "./dist/permissions/index.d.ts", "import": "./dist/permissions/index.js" },
    "./permissions/file-store": { "types": "./dist/permissions/file-store.d.ts", "import": "./dist/permissions/file-store.js" },
    "./plugin": { "types": "./dist/plugin/index.d.ts", "import": "./dist/plugin/index.js" },
    "./services": { "types": "./dist/services/index.d.ts", "import": "./dist/services/index.js" },
    "./services/models": { "types": "./dist/services/models.d.ts", "import": "./dist/services/models.js" },
    "./services/runtime": { "types": "./dist/services/runtime.d.ts", "import": "./dist/services/runtime.js" },
    "./services/permissions": { "types": "./dist/services/permissions.d.ts", "import": "./dist/services/permissions.js" },
    "./services/skills": { "types": "./dist/services/skills.d.ts", "import": "./dist/services/skills.js" },
    "./config": { "types": "./dist/config/index.d.ts", "import": "./dist/config/index.js" },
    "./config/schema": "./may-config.schema.json",
    "./skills": { "types": "./dist/skills/index.d.ts", "import": "./dist/skills/index.js" },
    "./goals": { "types": "./dist/goals/index.d.ts", "import": "./dist/goals/index.js" },
    "./goals/plugin": { "types": "./dist/goals/plugin.d.ts", "import": "./dist/goals/plugin.js" },
    "./history-memory": { "types": "./dist/history-memory/index.d.ts", "import": "./dist/history-memory/index.js" }
  },
  "files": ["dist", "!dist/.tsbuildinfo", "may-config.schema.json", "docs", "README.zh-CN.md"],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm run build && node --test test/*/*.test.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage test/*/*.test.mjs",
    "test:package": "pnpm run build && node --test test/application/git-workspace-package.test.mjs",
    "test:integration": "pnpm run build && node --test test/*/integration/*.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "diff": "9.0.0",
    "fs-native-extensions": "1.5.1",
    "import-meta-resolve": "^4.2.0",
    "json-canonicalize": "^3.0.1",
    "semver": "^7.7.2",
    "simple-git": "^4.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": { "@types/node": "^22.0.0", "@types/semver": "^7.7.0" },
  "engines": { "node": ">=22.16.0" },
  "license": "MIT"
}
