{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "May configuration",
  "description": "Configuration for May model profiles and provider adapters. Each application describes its own entry under apps.",
  "type": "object",
  "required": ["providers"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional editor hint pointing to this schema."
    },
    "defaultModel": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "Default model profile name."
    },
    "providers": {
      "type": "object",
      "description": "Named provider connections.",
      "propertyNames": { "$ref": "#/$defs/nonEmptyString" },
      "additionalProperties": { "$ref": "#/$defs/provider" }
    },
    "models": {
      "type": "object",
      "description": "Named, user-selectable model profiles.",
      "default": {},
      "propertyNames": { "$ref": "#/$defs/nonEmptyString" },
      "additionalProperties": { "$ref": "#/$defs/model" }
    },
    "apps": {
      "type": "object",
      "description": "Application-owned settings. Each application validates its own entry.",
      "default": {},
      "propertyNames": { "$ref": "#/$defs/nonEmptyString" },
      "additionalProperties": { "type": "object" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pluginSelections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module"],
        "properties": {
          "module": { "type": "string", "minLength": 1 },
          "export": { "type": "string", "minLength": 1, "default": "default" },
          "config": {},
          "enabled": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      }
    },
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reasoningEffort": {
      "type": "string",
      "minLength": 1,
      "description": "Model-specific value. Use model capabilities or MaybeCode /effort to discover supported levels."
    },
    "provider": {
      "type": "object",
      "required": ["adapter"],
      "properties": {
        "adapter": { "$ref": "#/$defs/nonEmptyString" },
        "apiKey": { "$ref": "#/$defs/nonEmptyString" },
        "apiKeyEnv": { "$ref": "#/$defs/nonEmptyString" },
        "baseURL": { "$ref": "#/$defs/nonEmptyString" },
        "capabilities": { "$ref": "#/$defs/modelCapabilities" },
        "options": {
          "type": "object",
          "description": "Adapter-specific shared options. A model profile may override them."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "adapter": { "const": "openai-responses" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/openaiResponsesOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "openai-chat-completions" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/openaiChatOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "deepseek-chat" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/deepseekOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "zhipu-chat" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/zhipuOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "kimi-chat" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/kimiOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "anthropic-messages" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/anthropicOptions" } } }
        }
      ],
      "not": { "required": ["apiKey", "apiKeyEnv"] },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": { "$ref": "#/$defs/nonEmptyString" },
        "adapter": { "$ref": "#/$defs/nonEmptyString" },
        "model": { "$ref": "#/$defs/nonEmptyString" },
        "contextWindowTokens": { "$ref": "#/$defs/positiveInteger" },
        "maxOutputTokens": { "$ref": "#/$defs/positiveInteger" },
        "options": { "$ref": "#/$defs/knownModelOptions" },
        "capabilities": { "$ref": "#/$defs/modelCapabilities" }
      },
      "allOf": [
        {
          "if": { "properties": { "adapter": { "const": "openai-responses" } }, "required": ["adapter"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/openaiResponsesOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "openai-chat-completions" } }, "required": ["adapter"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/openaiChatOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "deepseek-chat" } }, "required": ["adapter"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/deepseekOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "zhipu-chat" } }, "required": ["adapter"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/zhipuOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "kimi-chat" } }, "required": ["adapter"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/kimiOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "anthropic-messages" } }, "required": ["adapter"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/anthropicOptions" } } }
        }
      ],
      "additionalProperties": false
    },
    "modelCapabilities": {
      "type": "object",
      "description": "Explicit model capability overrides. These take precedence over provider discovery and May's built-in catalog.",
      "properties": {
        "fields": { "$ref": "#/$defs/capabilityFields" },
        "reasoning": {
          "oneOf": [{ "const": false }, { "$ref": "#/$defs/reasoningCapabilities" }]
        }
      },
      "additionalProperties": false
    },
    "capabilityFields": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "input.text",
          "input.image",
          "input.audio",
          "input.file",
          "input.resource",
          "input.image.sources",
          "input.audio.sources",
          "input.file.sources",
          "output.text",
          "output.image",
          "output.audio",
          "tools",
          "tools.maxCalls",
          "structuredOutput.json",
          "structuredOutput.jsonSchema",
          "structuredOutput.schemaDialects",
          "structuredOutput.schemaConstraint",
          "contextWindowTokens",
          "maxOutputTokens",
          "maxImages",
          "maxAttachments",
          "maxAttachmentBytes",
          "fileTypes",
          "parameters",
          "contextCompaction",
          "reasoning.modes"
        ]
      },
      "additionalProperties": { "type": "boolean" },
      "properties": {
        "contextWindowTokens": { "$ref": "#/$defs/capabilityLimit" },
        "maxOutputTokens": { "$ref": "#/$defs/capabilityLimit" },
        "maxImages": { "$ref": "#/$defs/capabilityLimit" },
        "maxAttachments": { "$ref": "#/$defs/capabilityLimit" },
        "maxAttachmentBytes": { "$ref": "#/$defs/capabilityLimit" },
        "tools.maxCalls": { "$ref": "#/$defs/capabilityLimit" },
        "input.image.sources": { "$ref": "#/$defs/capabilitySources" },
        "input.audio.sources": { "$ref": "#/$defs/capabilitySources" },
        "input.file.sources": { "$ref": "#/$defs/capabilitySources" },
        "fileTypes": { "$ref": "#/$defs/capabilityStrings" },
        "reasoning.modes": { "$ref": "#/$defs/capabilityStrings" },
        "structuredOutput.schemaDialects": { "$ref": "#/$defs/capabilityStrings" },
        "structuredOutput.schemaConstraint": { "oneOf": [{ "const": false }, { "type": "object" }] },
        "parameters": { "oneOf": [{ "const": false }, { "type": "object" }] }
      }
    },
    "capabilityLimit": { "oneOf": [{ "const": false }, { "$ref": "#/$defs/positiveInteger" }] },
    "capabilityStrings": {
      "oneOf": [
        { "const": false },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } }
      ]
    },
    "capabilitySources": {
      "oneOf": [
        { "const": false },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["url", "base64", "file"] } }
      ]
    },
    "reasoningCapabilities": {
      "type": "object",
      "required": ["efforts"],
      "properties": {
        "efforts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "defaultEffort": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "knownModelOptions": {
      "type": "object",
      "description": "Options are interpreted by the effective adapter. Unknown keys remain allowed for custom adapters.",
      "properties": {
        "responseFormat": { "$ref": "#/$defs/modelResponseFormat" },
        "unknownCapabilityPolicy": { "enum": ["allow", "require-known"] },
        "thinking": {
          "oneOf": [
            { "type": "string", "enum": ["enabled", "disabled"] },
            { "$ref": "#/$defs/kimiThinking" },
            { "$ref": "#/$defs/anthropicThinking" }
          ]
        },
        "clearThinking": { "type": "boolean" },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "reasoningSummary": { "type": "string", "enum": ["auto", "concise", "detailed"] },
        "maxTokens": { "$ref": "#/$defs/positiveInteger" },
        "maxOutputTokens": { "$ref": "#/$defs/positiveInteger" },
        "serverCompactThreshold": { "$ref": "#/$defs/positiveInteger" },
        "store": { "type": "boolean" },
        "apiVersion": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": true
    },
    "openaiResponsesOptions": {
      "type": "object",
      "properties": {
        "responseFormat": { "$ref": "#/$defs/modelResponseFormat" },
        "unknownCapabilityPolicy": { "enum": ["allow", "require-known"] },
        "maxOutputTokens": { "$ref": "#/$defs/positiveInteger" },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "reasoningSummary": { "type": "string", "enum": ["auto", "concise", "detailed"] },
        "serverCompactThreshold": { "$ref": "#/$defs/positiveInteger" },
        "store": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "openaiChatOptions": {
      "type": "object",
      "properties": {
        "responseFormat": { "$ref": "#/$defs/modelResponseFormat" },
        "unknownCapabilityPolicy": { "enum": ["allow", "require-known"] },
        "maxOutputTokens": { "$ref": "#/$defs/positiveInteger" },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "store": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "deepseekOptions": {
      "type": "object",
      "properties": {
        "unknownCapabilityPolicy": { "enum": ["allow", "require-known"] },
        "thinking": { "type": "string", "enum": ["enabled", "disabled"] },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "maxTokens": { "$ref": "#/$defs/positiveInteger" }
      },
      "additionalProperties": false
    },
    "zhipuOptions": {
      "type": "object",
      "properties": {
        "unknownCapabilityPolicy": { "enum": ["allow", "require-known"] },
        "thinking": { "type": "string", "enum": ["enabled", "disabled"] },
        "clearThinking": { "type": "boolean" },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "maxTokens": { "$ref": "#/$defs/positiveInteger" }
      },
      "additionalProperties": false
    },
    "kimiThinking": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["enabled", "disabled"] },
        "keep": { "enum": ["all", null] }
      },
      "additionalProperties": false
    },
    "kimiOptions": {
      "type": "object",
      "properties": {
        "unknownCapabilityPolicy": { "enum": ["allow", "require-known"] },
        "thinking": { "$ref": "#/$defs/kimiThinking" },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "maxTokens": { "$ref": "#/$defs/positiveInteger" }
      },
      "additionalProperties": false
    },
    "anthropicThinking": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "budgetTokens"],
          "properties": {
            "type": { "const": "enabled" },
            "budgetTokens": { "$ref": "#/$defs/positiveInteger" },
            "display": { "type": "string", "enum": ["summarized", "omitted"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "adaptive" },
            "display": { "type": "string", "enum": ["summarized", "omitted"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "disabled" } },
          "additionalProperties": false
        }
      ]
    },
    "anthropicOptions": {
      "type": "object",
      "properties": {
        "promptCaching": {
          "oneOf": [
            { "const": false },
            {
              "type": "object",
              "properties": {
                "ttl": { "enum": ["5m", "1h"] },
                "cacheInstructions": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          ]
        },
        "unknownCapabilityPolicy": { "enum": ["allow", "require-known"] },
        "thinking": { "$ref": "#/$defs/anthropicThinking" },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "maxTokens": { "$ref": "#/$defs/positiveInteger" },
        "apiVersion": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "modelResponseFormat": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "type": { "const": "json" } },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "jsonSchema" },
            "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
            "schema": { "type": "object" },
            "strict": { "type": "boolean" }
          },
          "required": ["type", "name", "schema"],
          "additionalProperties": false
        }
      ]
    },
    "runBudget": {
      "type": "object",
      "properties": {
        "maxDurationMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "maxSteps": { "$ref": "#/$defs/positiveInteger" },
        "maxModelCalls": { "$ref": "#/$defs/positiveInteger" },
        "maxToolCalls": { "$ref": "#/$defs/positiveInteger" },
        "maxTotalTokens": { "$ref": "#/$defs/positiveInteger" },
        "maxCostUsd": { "type": "number", "exclusiveMinimum": 0 },
        "tokenPrices": {
          "type": "object",
          "required": ["inputUsdPerMillion", "outputUsdPerMillion"],
          "properties": {
            "inputUsdPerMillion": { "type": "number", "minimum": 0 },
            "outputUsdPerMillion": { "type": "number", "minimum": 0 },
            "cachedReadUsdPerMillion": { "type": "number", "minimum": 0 },
            "cachedWriteUsdPerMillion": { "type": "number", "minimum": 0 },
            "reasoningUsdPerMillion": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "pricing": { "$ref": "#/$defs/tokenPriceSchedule" }
      },
      "not": { "required": ["tokenPrices", "pricing"] },
      "if": { "required": ["maxCostUsd"] },
      "then": {
        "anyOf": [{ "required": ["tokenPrices"] }, { "required": ["pricing"] }],
        "properties": { "pricing": { "properties": { "currency": { "const": "USD" } } } }
      },
      "additionalProperties": false
    },
    "tokenPriceSchedule": {
      "type": "object",
      "required": ["id", "version", "currency", "source", "effectiveAt", "inputPerMillion", "outputPerMillion"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "source": { "type": "string", "minLength": 1, "maxLength": 256 },
        "effectiveAt": { "type": "string", "format": "date-time" },
        "inputPerMillion": { "type": "number", "minimum": 0 },
        "outputPerMillion": { "type": "number", "minimum": 0 },
        "cachedReadPerMillion": { "type": "number", "minimum": 0 },
        "cachedWritePerMillion": { "type": "number", "minimum": 0 },
        "reasoningPerMillion": { "type": "number", "minimum": 0 },
        "items": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "object",
            "required": ["unit", "perUnit"],
            "properties": {
              "unit": { "type": "string", "minLength": 1, "maxLength": 256 },
              "perUnit": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
