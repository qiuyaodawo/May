{
  "name": "@sortedyuan/config",
  "version": "0.3.1",
  "description": "Configuration loading and validation for May applications.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./may-config.schema.json"
  },
  "files": [
    "dist",
    "may-config.schema.json",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage test/*.test.mjs"
  },
  "dependencies": {
    "@sortedyuan/session": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
