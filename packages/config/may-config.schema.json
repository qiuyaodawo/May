{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "May configuration",
  "description": "Configuration for May applications, model profiles, and provider adapters.",
  "type": "object",
  "required": ["providers"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional editor hint pointing to this schema."
    },
    "defaultModel": {
      "type": "string",
      "minLength": 1,
      "description": "Default model profile name."
    },
    "providers": {
      "type": "object",
      "description": "Named provider connections.",
      "additionalProperties": { "$ref": "#/$defs/provider" }
    },
    "models": {
      "type": "object",
      "description": "Named, user-selectable model profiles.",
      "default": {},
      "additionalProperties": { "$ref": "#/$defs/model" }
    },
    "apps": {
      "type": "object",
      "description": "Application-owned settings.",
      "default": {},
      "properties": {
        "maybecode": { "$ref": "#/$defs/maybecode" },
        "maybeclaw": {
          "type": "object",
          "properties": {
            "version": { "const": 2, "description": "Agent Gateway configuration version." },
            "persistentRules": { "type": "boolean", "default": false, "description": "Enable administrator-managed persistent permissions in the Gateway data directory." },
            "agents": { "type": "array", "items": { "$ref": "#/$defs/maybeclawAgent" } },
            "access": {
              "type": "object",
              "properties": {
                "sessionAdmins": { "$ref": "#/$defs/maybeclawIdentityLists" },
                "creators": { "$ref": "#/$defs/maybeclawIdentityList" },
                "deniedUsers": { "$ref": "#/$defs/maybeclawIdentityList" },
                "allowedAgents": { "type": "object", "propertyNames": { "$ref": "#/$defs/maybeclawIdentifier" }, "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/maybeclawAgentId" }, "uniqueItems": true } }
              },
              "additionalProperties": false
            },
            "runBudget": { "$ref": "#/$defs/runBudget" },
            "server": {
              "type": "object",
              "properties": {
                "maxConcurrent": { "type": "integer", "minimum": 1, "default": 4 },
                "auth": {
                  "type": "object",
                  "properties": {
                    "password": { "type": "string", "minLength": 10, "maxLength": 1024, "writeOnly": true, "description": "Administrator password, automatically replaced with passwordHash by the running Gateway or at startup." },
                    "passwordHash": { "type": "string", "maxLength": 512, "writeOnly": true, "description": "Generated Argon2id password hash." },
                    "sessionMs": { "type": "integer", "minimum": 1000, "maximum": 86400000, "default": 28800000 }
                  },
                  "anyOf": [{ "required": ["password"] }, { "required": ["passwordHash"] }],
                  "additionalProperties": false
                },
                "idleMs": { "type": "integer", "minimum": 0, "default": 600000 },
                "shutdownMs": { "type": "integer", "minimum": 0, "maximum": 2147483647, "default": 30000 },
                "approvalMs": { "type": "integer", "minimum": 1, "default": 600000 },
                "publicOrigin": { "type": "string", "format": "uri", "pattern": "^https://[^/?#@\\s]+$", "description": "Canonical HTTPS origin of the control service behind a reverse proxy, without a path, query, fragment, or credentials." }
              },
              "additionalProperties": false
            },
            "channels": {
              "type": "object",
              "properties": {
                "telegram": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean", "default": false },
                    "botToken": { "$ref": "#/$defs/channelCredential", "description": "Literal bot token. Do not also set botTokenEnv." },
                    "botTokenEnv": { "$ref": "#/$defs/credentialEnv", "default": "MAYBECLAW_TELEGRAM_TOKEN" },
                    "allowUsers": { "type": "array", "items": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }, "uniqueItems": true },
                    "allowGroups": { "type": "array", "items": { "type": "string", "pattern": "^-[1-9][0-9]{0,19}$" }, "uniqueItems": true },
                    "groupTrigger": { "enum": ["explicit", "all"], "default": "explicit" },
                    "entranceTriggers": { "type": "array", "items": { "$ref": "#/$defs/maybeclawEntranceTrigger" }, "uniqueItems": true }
                  },
                  "if": { "required": ["enabled"], "properties": { "enabled": { "const": true } } },
                  "then": { "anyOf": [
                    { "required": ["allowUsers"], "properties": { "allowUsers": { "minItems": 1 } } },
                    { "required": ["allowGroups"], "properties": { "allowGroups": { "minItems": 1 } } }
                  ] },
                  "not": { "required": ["botToken", "botTokenEnv"] },
                  "additionalProperties": false
                },
                "feishu": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean", "default": false },
                    "appId": { "type": "string" },
                    "appSecret": { "$ref": "#/$defs/channelCredential", "description": "Literal app secret. Do not also set appSecretEnv." },
                    "appSecretEnv": { "$ref": "#/$defs/credentialEnv", "default": "MAYBECLAW_FEISHU_SECRET" },
                    "allowUsers": { "type": "array", "items": { "type": "string", "pattern": "^ou_[A-Za-z0-9_-]{1,128}$" }, "uniqueItems": true },
                    "allowGroups": { "type": "array", "items": { "type": "string", "pattern": "^oc_[A-Za-z0-9_-]{1,128}$" }, "uniqueItems": true },
                    "groupTrigger": { "enum": ["explicit", "all"], "default": "explicit" },
                    "entranceTriggers": { "type": "array", "items": { "$ref": "#/$defs/maybeclawEntranceTrigger" }, "uniqueItems": true }
                  },
                  "if": { "required": ["enabled"], "properties": { "enabled": { "const": true } } },
                  "then": { "required": ["appId"], "properties": { "appId": { "pattern": "^cli_[0-9a-fA-F]{16}$" } }, "anyOf": [
                    { "required": ["allowUsers"], "properties": { "allowUsers": { "minItems": 1 } } },
                    { "required": ["allowGroups"], "properties": { "allowGroups": { "minItems": 1 } } }
                  ] },
                  "not": { "required": ["appSecret", "appSecretEnv"] },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "if": { "required": ["version"], "properties": { "version": { "const": 2 } } },
          "then": { "not": { "required": ["runBudget"] } },
          "else": {
            "not": { "anyOf": [{ "required": ["agents"] }, { "required": ["access"] }] },
            "properties": { "server": { "properties": { "maxConcurrent": { "maximum": 4 } } } }
          }
        }
      },
      "additionalProperties": { "type": "object" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pluginSelections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module"],
        "properties": {
          "module": { "type": "string", "minLength": 1 },
          "export": { "type": "string", "minLength": 1, "default": "default" },
          "config": {},
          "enabled": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      }
    },
    "maybeclawAgentId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$" },
    "maybeclawIdentifier": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$" },
    "maybeclawIdentityList": { "type": "array", "items": { "$ref": "#/$defs/maybeclawIdentifier" }, "uniqueItems": true },
    "maybeclawIdentityLists": { "type": "object", "propertyNames": { "$ref": "#/$defs/maybeclawIdentifier" }, "additionalProperties": { "$ref": "#/$defs/maybeclawIdentityList" } },
    "maybeclawEntranceTrigger": {
      "type": "object",
      "required": ["conversation", "trigger"],
      "properties": {
        "conversation": { "type": "string", "minLength": 1, "maxLength": 256 },
        "threadId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "trigger": { "enum": ["explicit", "all"] }
      },
      "additionalProperties": false
    },
    "maybeclawAgent": {
      "type": "object",
      "required": ["id", "adapter"],
      "properties": {
        "id": { "$ref": "#/$defs/maybeclawAgentId" },
        "name": { "$ref": "#/$defs/maybeclawIdentifier" },
        "adapter": { "enum": ["may", "module"] },
        "enabled": { "type": "boolean", "default": true },
        "model": { "$ref": "#/$defs/maybeclawIdentifier" },
        "instructions": { "type": "string" },
        "media": { "type": "array", "uniqueItems": true, "items": { "enum": ["image", "audio", "file", "video"] }, "description": "Explicit input media capabilities; video remains a file content part with a video MIME type." },
        "readDirectory": { "$ref": "#/$defs/maybeclawIdentifier", "description": "Absolute directory, validated using the host platform's path rules." },
        "module": { "$ref": "#/$defs/maybeclawIdentifier" },
        "export": { "$ref": "#/$defs/maybeclawIdentifier", "default": "createAdapter" },
        "options": { "type": "object" },
        "plugins": { "$ref": "#/$defs/pluginSelections" },
        "idleMs": { "type": "integer", "minimum": 0 },
        "runBudget": { "$ref": "#/$defs/runBudget" },
        "permissions": { "type": "object", "propertyNames": { "$ref": "#/$defs/maybeclawIdentifier" }, "additionalProperties": { "enum": ["allow", "deny", "ask"] } }
      },
      "if": { "properties": { "adapter": { "const": "module" } } },
      "then": { "required": ["module"], "not": { "required": ["plugins"] } },
      "else": { "not": { "anyOf": [{ "required": ["module"] }, { "required": ["export"] }, { "required": ["options"] }] } },
      "additionalProperties": false
    },
    "channelCredential": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^\\S+$", "writeOnly": true },
    "credentialEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "subagentIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "subagentRole": {
      "type": "object",
      "properties": {
        "model": { "$ref": "#/$defs/subagentIdentifier", "description": "Model profile name. Without it the role inherits the main Session model and reasoning effort." },
        "reasoningEffort": { "$ref": "#/$defs/nonEmptyString" },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "tools": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["read", "shell", "edit", "write"] }
        },
        "delegateTo": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/subagentIdentifier" }
        },
        "runBudget": { "$ref": "#/$defs/runBudget" }
      },
      "additionalProperties": false
    },
    "reasoningEffort": {
      "type": "string",
      "minLength": 1,
      "description": "Model-specific value. Use model capabilities or MaybeCode /effort to discover supported levels."
    },
    "provider": {
      "type": "object",
      "required": ["adapter"],
      "properties": {
        "adapter": { "$ref": "#/$defs/nonEmptyString" },
        "apiKey": { "$ref": "#/$defs/nonEmptyString" },
        "apiKeyEnv": { "$ref": "#/$defs/nonEmptyString" },
        "baseURL": { "$ref": "#/$defs/nonEmptyString" },
        "options": {
          "type": "object",
          "description": "Adapter-specific shared options. A model profile may override them."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "adapter": { "const": "openai-responses" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/openaiResponsesOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "openai-chat-completions" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/openaiChatOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "deepseek-chat" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/deepseekOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "zhipu-chat" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/zhipuOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "kimi-chat" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/kimiOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "anthropic-messages" } } },
          "then": { "properties": { "options": { "$ref": "#/$defs/anthropicOptions" } } }
        }
      ],
      "not": { "required": ["apiKey", "apiKeyEnv"] },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": { "$ref": "#/$defs/nonEmptyString" },
        "adapter": { "$ref": "#/$defs/nonEmptyString" },
        "model": { "$ref": "#/$defs/nonEmptyString" },
        "contextWindowTokens": { "$ref": "#/$defs/positiveInteger" },
        "maxOutputTokens": { "$ref": "#/$defs/positiveInteger" },
        "options": { "$ref": "#/$defs/knownModelOptions" },
        "capabilities": { "$ref": "#/$defs/modelCapabilities" }
      },
      "allOf": [
        {
          "if": { "properties": { "adapter": { "const": "openai-responses" } }, "required": ["adapter"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/openaiResponsesOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "openai-chat-completions" } }, "required": ["adapter"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/openaiChatOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "deepseek-chat" } }, "required": ["adapter"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/deepseekOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "zhipu-chat" } }, "required": ["adapter"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/zhipuOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "kimi-chat" } }, "required": ["adapter"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/kimiOptions" } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "anthropic-messages" } }, "required": ["adapter"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/anthropicOptions" } } }
        }
      ],
      "additionalProperties": false
    },
    "modelCapabilities": {
      "type": "object",
      "description": "Explicit model capability overrides. These take precedence over provider discovery and May's built-in catalog.",
      "properties": {
        "reasoning": {
          "oneOf": [
            { "const": false },
            { "$ref": "#/$defs/reasoningCapabilities" }
          ]
        }
      },
      "additionalProperties": false
    },
    "reasoningCapabilities": {
      "type": "object",
      "required": ["efforts"],
      "properties": {
          "efforts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "defaultEffort": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "knownModelOptions": {
      "type": "object",
      "description": "Options are interpreted by the effective adapter. Unknown keys remain allowed for custom adapters.",
      "properties": {
        "thinking": {
          "oneOf": [
            { "type": "string", "enum": ["enabled", "disabled"] },
            { "$ref": "#/$defs/kimiThinking" },
            { "$ref": "#/$defs/anthropicThinking" }
          ]
        },
        "clearThinking": { "type": "boolean" },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "reasoningSummary": { "type": "string", "enum": ["auto", "concise", "detailed"] },
        "maxTokens": { "$ref": "#/$defs/positiveInteger" },
        "maxOutputTokens": { "$ref": "#/$defs/positiveInteger" },
        "serverCompactThreshold": { "$ref": "#/$defs/positiveInteger" },
        "store": { "type": "boolean" },
        "apiVersion": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": true
    },
    "openaiResponsesOptions": {
      "type": "object",
      "properties": {
        "maxOutputTokens": { "$ref": "#/$defs/positiveInteger" },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "reasoningSummary": { "type": "string", "enum": ["auto", "concise", "detailed"] },
        "serverCompactThreshold": { "$ref": "#/$defs/positiveInteger" },
        "store": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "openaiChatOptions": {
      "type": "object",
      "properties": {
        "maxOutputTokens": { "$ref": "#/$defs/positiveInteger" },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "store": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "deepseekOptions": {
      "type": "object",
      "properties": {
        "thinking": { "type": "string", "enum": ["enabled", "disabled"] },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "maxTokens": { "$ref": "#/$defs/positiveInteger" }
      },
      "additionalProperties": false
    },
    "zhipuOptions": {
      "type": "object",
      "properties": {
        "thinking": { "type": "string", "enum": ["enabled", "disabled"] },
        "clearThinking": { "type": "boolean" },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "maxTokens": { "$ref": "#/$defs/positiveInteger" }
      },
      "additionalProperties": false
    },
    "kimiThinking": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["enabled", "disabled"] },
        "keep": { "enum": ["all", null] }
      },
      "additionalProperties": false
    },
    "kimiOptions": {
      "type": "object",
      "properties": {
        "thinking": { "$ref": "#/$defs/kimiThinking" },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "maxTokens": { "$ref": "#/$defs/positiveInteger" }
      },
      "additionalProperties": false
    },
    "anthropicThinking": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "budgetTokens"],
          "properties": {
            "type": { "const": "enabled" },
            "budgetTokens": { "$ref": "#/$defs/positiveInteger" },
            "display": { "type": "string", "enum": ["summarized", "omitted"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "adaptive" },
            "display": { "type": "string", "enum": ["summarized", "omitted"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "disabled" } },
          "additionalProperties": false
        }
      ]
    },
    "anthropicOptions": {
      "type": "object",
      "properties": {
        "thinking": { "$ref": "#/$defs/anthropicThinking" },
        "reasoningEffort": { "$ref": "#/$defs/reasoningEffort" },
        "maxTokens": { "$ref": "#/$defs/positiveInteger" },
        "apiVersion": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "runBudget": {
      "type": "object",
      "properties": {
        "maxDurationMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "maxSteps": { "$ref": "#/$defs/positiveInteger" },
        "maxModelCalls": { "$ref": "#/$defs/positiveInteger" },
        "maxToolCalls": { "$ref": "#/$defs/positiveInteger" },
        "maxTotalTokens": { "$ref": "#/$defs/positiveInteger" },
        "maxCostUsd": { "type": "number", "exclusiveMinimum": 0 },
        "tokenPrices": {
          "type": "object",
          "required": ["inputUsdPerMillion", "outputUsdPerMillion"],
          "properties": {
            "inputUsdPerMillion": { "type": "number", "minimum": 0 },
            "outputUsdPerMillion": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "dependentRequired": { "maxCostUsd": ["tokenPrices"] },
      "additionalProperties": false
    },
    "maybecode": {
      "type": "object",
      "properties": {
        "git": {
          "oneOf": [
            { "const": false },
            { "type": "object", "properties": {
              "autoCommit": { "type": "boolean", "default": true },
              "readOnly": { "type": "boolean", "default": false },
              "dataRoot": { "$ref": "#/$defs/nonEmptyString" },
              "worktreesRoot": { "$ref": "#/$defs/nonEmptyString" },
              "excludedPaths": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
            }, "additionalProperties": false }
          ]
        },
        "plugins": { "$ref": "#/$defs/pluginSelections" },
        "permissionMode": { "enum": ["default", "yolo"], "default": "default", "description": "Tool approval mode. yolo auto-approves requests while preserving explicit policy denials." },
        "persistentRules": { "type": "boolean", "default": false, "description": "Enable project-scoped persistent file permissions in .may/permission-rules.json." },
        "instructionsDirectory": { "$ref": "#/$defs/nonEmptyString" },
        "skills": {
          "oneOf": [
            { "const": false },
            { "type": "object", "properties": {
                "directories": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/nonEmptyString" } }
              }, "additionalProperties": false }
          ]
        },
        "runBudget": { "$ref": "#/$defs/runBudget" },
        "subagents": {
          "oneOf": [
            { "const": false },
            {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean", "default": true, "description": "Sub-agent delegation for ordinary requests. Enabled by default." },
                "roles": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 8,
                  "propertyNames": { "$ref": "#/$defs/subagentIdentifier" },
                  "additionalProperties": { "$ref": "#/$defs/subagentRole" }
                },
                "defaultRole": { "$ref": "#/$defs/subagentIdentifier" },
                "limits": {
                  "type": "object",
                  "properties": {
                    "maxConcurrent": { "type": "integer", "minimum": 1, "maximum": 8, "default": 2 },
                    "maxTasks": { "type": "integer", "minimum": 1, "maximum": 128, "default": 24 },
                    "maxDepth": { "type": "integer", "minimum": 2, "maximum": 4, "default": 3 },
                    "maxTaskTurns": { "type": "integer", "minimum": 2, "maximum": 16, "default": 6 },
                    "maxDurationMs": { "type": "integer", "minimum": 1, "maximum": 3600000, "default": 900000 },
                    "maxInputBytes": { "type": "integer", "minimum": 1, "maximum": 65536, "default": 32768 },
                    "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 262144, "default": 65536 }
                  },
                  "additionalProperties": false
                },
                "runBudget": { "$ref": "#/$defs/runBudget", "description": "Per child Run budget." },
                "maxModelCalls": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 128, "description": "Model calls reserved across the main Run, child Runs and compaction of one request." },
                "maxTotalTokens": { "type": "integer", "minimum": 1, "description": "Optional token ceiling checked against per-call reservations." },
                "reservationTokens": { "type": "integer", "minimum": 1, "maximum": 10000000, "default": 32768 }
              },
              "additionalProperties": false
            }
          ]
        },
        "autoCompaction": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["prune-summary", "history-reference", "provider-native"],
              "default": "prune-summary"
            },
            "providerNative": {
              "type": "boolean",
              "deprecated": true,
              "description": "Legacy alias: true selects provider-native mode when mode is absent."
            }
          },
          "additionalProperties": false
        },
        "retry": {
          "oneOf": [
            { "const": false },
            {
              "type": "object",
              "properties": {
                "maxAttempts": { "$ref": "#/$defs/positiveInteger" },
                "baseDelayMs": { "type": "number", "minimum": 0 },
                "maxDelayMs": { "type": "number", "minimum": 0 },
                "jitterRatio": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            }
          ]
        },
        "observability": {
          "oneOf": [
            { "const": false },
            {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean", "default": true },
                "exporter": { "const": "file", "default": "file" },
                "file": { "$ref": "#/$defs/nonEmptyString" },
                "samplingRatio": { "type": "number", "minimum": 0, "maximum": 1 },
                "retentionDays": { "$ref": "#/$defs/positiveInteger", "default": 60 },
                "batch": {
                  "type": "object",
                  "properties": {
                    "maxQueueSize": { "$ref": "#/$defs/positiveInteger" },
                    "maxExportBatchSize": { "$ref": "#/$defs/positiveInteger" },
                    "scheduledDelayMs": { "type": "number", "minimum": 0 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "mcpServers": {
          "oneOf": [
            { "const": false },
            {
              "type": "object",
              "propertyNames": { "pattern": "^[A-Za-z0-9_-]+$" },
              "additionalProperties": {
                "oneOf": [
                  { "$ref": "#/$defs/mcpStdioServer" },
                  { "$ref": "#/$defs/mcpHttpServer" }
                ]
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "mcpStdioServer": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "required": { "type": "boolean", "default": true },
        "transport": { "const": "stdio", "default": "stdio" },
        "protocolMode": { "enum": ["legacy", "auto"], "default": "legacy" },
        "host": { "$ref": "#/$defs/mcpHostOptions" },
        "tasks": { "type": "boolean", "default": false, "description": "Enable the modern Tasks extension with durable encrypted handles." },
        "command": { "$ref": "#/$defs/nonEmptyString" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cwd": { "$ref": "#/$defs/nonEmptyString" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "requestTimeoutMs": { "$ref": "#/$defs/positiveInteger" },
        "maxTotalTimeoutMs": { "$ref": "#/$defs/positiveInteger" },
        "maxBufferSize": { "$ref": "#/$defs/positiveInteger" },
        "stderrMaxBytes": {
          "$ref": "#/$defs/positiveInteger",
          "default": 16384
        }
      },
      "anyOf": [
        {
          "required": ["enabled"],
          "properties": { "enabled": { "const": false } }
        },
        { "required": ["command"] }
      ],
      "additionalProperties": false
    },
    "mcpHttpServer": {
      "type": "object",
      "required": ["transport"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "required": { "type": "boolean", "default": true },
        "transport": { "const": "streamable-http" },
        "url": { "$ref": "#/$defs/nonEmptyString", "description": "HTTPS endpoint (HTTP only on loopback); redirects and URL credentials are refused at runtime." },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "auth": { "$ref": "#/$defs/mcpOAuthOptions" },
        "protocolMode": { "enum": ["legacy", "auto"], "default": "auto" },
        "host": { "$ref": "#/$defs/mcpHostOptions" },
        "tasks": { "type": "boolean", "default": false, "description": "Enable the modern Tasks extension with durable encrypted handles." },
        "requestTimeoutMs": { "$ref": "#/$defs/positiveInteger" },
        "maxTotalTimeoutMs": { "$ref": "#/$defs/positiveInteger" }
      },
      "anyOf": [
        { "required": ["enabled"], "properties": { "enabled": { "const": false } } },
        { "required": ["url"] }
      ],
      "additionalProperties": false
    },
    "mcpHostOptions": {
      "type": "object",
      "description": "Explicit compatibility options; an active interaction UI and host services are also required.",
      "properties": {
        "roots": { "type": "boolean", "default": false },
        "sampling": { "type": "boolean", "default": false },
        "legacyRequests": { "const": "isolated", "description": "Use a fresh process/session for each legacy interactive operation, never shared or reused." }
      },
      "additionalProperties": false
    },
    "mcpOAuthOptions": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "oauth" },
        "account": { "$ref": "#/$defs/nonEmptyString" },
        "clientId": { "$ref": "#/$defs/nonEmptyString" },
        "expectedIssuer": { "$ref": "#/$defs/nonEmptyString" },
        "clientMetadataUrl": { "$ref": "#/$defs/nonEmptyString" },
        "scopes": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "authorizationOrigins": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "callbackPort": { "type": "integer", "minimum": 0, "maximum": 65535 }
      },
      "dependentRequired": { "clientId": ["expectedIssuer"] },
      "not": { "required": ["clientId", "clientMetadataUrl"] },
      "additionalProperties": false
    }
  }
}
