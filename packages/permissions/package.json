{
  "name": "@may/permissions",
  "version": "0.1.0",
  "description": "Headless tool permission and approval runtime for May agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
