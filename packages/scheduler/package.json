{
  "name": "@sortedyuan/scheduler",
  "version": "0.3.0",
  "description": "Opt-in durable time and event scheduling for host-owned tasks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite-store": {
      "types": "./dist/sqlite-store.d.ts",
      "import": "./dist/sqlite-store.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:live": "pnpm run build && node test/live-timer.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage test/*.test.mjs"
  },
  "dependencies": {
    "@sortedyuan/may": "workspace:*",
    "cron-parser": "^5.6.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@sortedyuan/test-support": "workspace:*",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "license": "MIT"
}
