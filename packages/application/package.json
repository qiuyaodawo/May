{
  "name": "@may/application",
  "version": "0.1.0",
  "description": "Reusable Agent definitions and headless application/workspace lifecycle for May agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./git-workspace": {
      "types": "./dist/git-workspace.d.ts",
      "import": "./dist/git-workspace.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:package": "pnpm run build && node --test test/git-workspace-package.test.mjs",
    "test:integration": "pnpm run build && node --test test/integration/*.test.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage test/*.test.mjs"
  },
  "dependencies": {
    "diff": "9.0.0",
    "simple-git": "^4.0.2",
    "@may/skills": "workspace:*",
    "@may/context": "workspace:*",
    "@may/core": "workspace:*",
    "@may/permissions": "workspace:*",
    "@may/plugin": "workspace:*",
    "@may/plugin-services": "workspace:*",
    "@may/plugin-models": "workspace:*",
    "@may/plugin-runtime": "workspace:*",
    "@may/plugin-permissions": "workspace:*",
    "@may/plugin-skills": "workspace:*",
    "@may/session": "workspace:*",
    "@may/session-tools": "workspace:*"
  },
  "devDependencies": {
    "@may/provider-openai": "workspace:*",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
