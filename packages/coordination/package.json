{
  "name": "@sortedyuan/coordination",
  "version": "0.4.0",
  "description": "Durable, single-host task graphs above May Agent applications.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./file-store": { "types": "./dist/file-store.d.ts", "import": "./dist/file-store.js" },
    "./remote": { "types": "./dist/remote-worker.d.ts", "import": "./dist/remote-worker.js" },
    "./plugin": { "types": "./dist/plugin.d.ts", "import": "./dist/plugin.js" }
  },
  "files": ["dist", "!dist/.tsbuildinfo", "docs"],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage test/*.test.mjs"
  },
  "dependencies": {
    "@sortedyuan/application": "workspace:*",
    "@sortedyuan/core": "workspace:*",
    "@sortedyuan/file-storage": "workspace:*",
    "@sortedyuan/plugin": "workspace:*",
    "@sortedyuan/permissions": "workspace:*",
    "@sortedyuan/session": "workspace:*"
  },
  "devDependencies": { "@types/node": "^22.0.0" },
  "engines": { "node": ">=22" },
  "license": "MIT"
}
