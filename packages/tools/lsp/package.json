{
  "name": "@sortedyuan/lsp-tools",
  "version": "0.0.0",
  "description": "Language server management and workspace tools for May.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "pnpm --filter @sortedyuan/coordination run build && pnpm run build && node --test test/*.test.mjs",
    "test:integration": "pnpm run build && node --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@sortedyuan/coding-tools": "workspace:*",
    "@sortedyuan/may": "workspace:*",
    "picomatch": "4.0.7",
    "vscode-jsonrpc": "10.0.0",
    "vscode-languageserver-protocol": "3.18.5",
    "vscode-languageserver-textdocument": "1.0.16",
    "vscode-uri": "3.2.0",
    "which": "6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sortedyuan/coordination": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.2",
    "@types/which": "^3.0.4",
    "pyright": "1.1.414",
    "typescript": "5.9.3",
    "typescript-language-server": "6.0.3"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "license": "MIT"
}
