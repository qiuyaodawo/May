{
  "name": "@sortedyuan/provider-gemini",
  "version": "0.1.0",
  "description": "Google Gemini native API model adapter for May.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "!dist/.tsbuildinfo"],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:integration": "pnpm --filter @sortedyuan/config run build && pnpm run build && node --test test-integration/*.test.mjs"
  },
  "dependencies": {
    "@sortedyuan/core": "workspace:*",
    "@sortedyuan/provider-openai-compatible": "workspace:*"
  },
  "devDependencies": { "@sortedyuan/config": "workspace:*", "@types/node": "^22.0.0" },
  "engines": { "node": ">=22" },
  "license": "MIT"
}
