{
  "name": "@sortedyuan/providers",
  "version": "0.2.0",
  "description": "Provider selection, registration, and built-in model composition for May.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/.tsbuildinfo"],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage test/*.test.mjs"
  },
  "dependencies": {
    "@sortedyuan/config": "workspace:*",
    "@sortedyuan/core": "workspace:*",
    "@sortedyuan/provider-anthropic": "workspace:*",
    "@sortedyuan/provider-deepseek": "workspace:*",
    "@sortedyuan/provider-gemini": "workspace:*",
    "@sortedyuan/provider-kimi": "workspace:*",
    "@sortedyuan/provider-openai": "workspace:*",
    "@sortedyuan/provider-openai-compatible": "workspace:*",
    "@sortedyuan/provider-zhipu": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "engines": { "node": ">=22" },
  "license": "MIT"
}
