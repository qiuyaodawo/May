{
  "name": "@sortedyuan/maybecode",
  "version": "0.4.0",
  "description": "Terminal coding agent built from May packages.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "maybecode": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/build-maybecode.mjs",
    "clean": "tsc -b --clean",
    "start": "pnpm run build && node dist/bin.js",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:browser": "pnpm run build && node --test test/browser/*.test.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage test/*.test.mjs",
    "test:integration": "pnpm run build && node --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@sortedyuan/may": "workspace:*",
    "@sortedyuan/coding-tools": "workspace:*",
    "@sortedyuan/coordination": "workspace:*",
    "@sortedyuan/mcp": "workspace:*",
    "@sortedyuan/media": "workspace:*",
    "@sortedyuan/observability": "workspace:*",
    "@sortedyuan/providers": "workspace:*",
    "@sortedyuan/tui": "workspace:*",
    "@sortedyuan/ui-client": "workspace:*",
    "@sortedyuan/web-ui": "workspace:*",
    "clipboardy": "5.3.2",
    "diff": "9.0.0",
    "open": "11.0.4"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.0.0"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
