{
  "name": "@may/maybecode",
  "version": "0.1.0",
  "description": "Terminal coding agent built from May packages.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "maybecode": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "start": "pnpm run build && node dist/bin.js",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage test/*.test.mjs",
    "test:integration": "pnpm run build && node --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@may/application": "workspace:*",
    "@may/coding-tools": "workspace:*",
    "@may/config": "workspace:*",
    "@may/context": "workspace:*",
    "@may/coordination": "workspace:*",
    "@may/core": "workspace:*",
    "@may/goal": "workspace:*",
    "@may/keybindings": "workspace:*",
    "@may/mcp": "workspace:*",
    "@may/observability": "workspace:*",
    "@may/permissions": "workspace:*",
    "@may/providers": "workspace:*",
    "@may/session": "workspace:*",
    "@may/skills": "workspace:*",
    "@may/tui": "workspace:*",
    "@may/ui-client": "workspace:*",
    "@may/web-ui": "workspace:*",
    "open": "11.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
