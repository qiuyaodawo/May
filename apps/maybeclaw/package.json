{
  "name": "@sortedyuan/maybeclaw",
  "version": "0.1.0",
  "description": "Agent gateway with durable conversations and chat channels.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rpc": {
      "types": "./dist/gateway-rpc-adapter.d.ts",
      "import": "./dist/gateway-rpc-adapter.js"
    }
  },
  "bin": {
    "maybeclaw": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:browser": "pnpm run build && node --test test/browser/*.test.mjs",
    "test:integration": "pnpm run build && node --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.73.3",
    "@sortedyuan/application": "workspace:*",
    "@sortedyuan/coding-tools": "workspace:*",
    "@sortedyuan/config": "workspace:*",
    "@sortedyuan/coordination": "workspace:*",
    "@sortedyuan/core": "workspace:*",
    "@sortedyuan/media": "workspace:*",
    "@sortedyuan/permissions": "workspace:*",
    "@sortedyuan/plugin": "workspace:*",
    "@sortedyuan/plugin-agent-adapters": "workspace:*",
    "@sortedyuan/plugin-channel-feishu": "workspace:*",
    "@sortedyuan/plugin-channel-telegram": "workspace:*",
    "@sortedyuan/plugin-coordination": "workspace:*",
    "@sortedyuan/plugin-delivery": "workspace:*",
    "@sortedyuan/plugin-models": "workspace:*",
    "@sortedyuan/plugin-observability": "workspace:*",
    "@sortedyuan/plugin-permissions": "workspace:*",
    "@sortedyuan/plugin-runtime": "workspace:*",
    "@sortedyuan/plugin-services": "workspace:*",
    "@sortedyuan/plugin-web-api": "workspace:*",
    "@sortedyuan/providers": "workspace:*",
    "@sortedyuan/session": "workspace:*",
    "@sortedyuan/ui-client": "workspace:*",
    "@sortedyuan/web-ui": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "open": "11.0.4",
    "shell-quote": "^1.10.0",
    "vscode-jsonrpc": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/shell-quote": "^1.7.5",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT"
}
