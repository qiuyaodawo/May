{
  "type": "object",
  "description": "MaybeClaw Agent Gateway settings.",
  "required": ["version"],
  "properties": {
    "version": { "const": 2, "description": "Agent Gateway configuration version." },
    "persistentRules": {
      "type": "boolean",
      "default": false,
      "description": "Enable administrator-managed persistent permissions in the Gateway data directory."
    },
    "agents": { "type": "array", "items": { "$ref": "#/$defs/maybeclawAgent" } },
    "access": {
      "type": "object",
      "properties": {
        "sessionAdmins": { "$ref": "#/$defs/maybeclawIdentityLists" },
        "creators": { "$ref": "#/$defs/maybeclawIdentityList" },
        "deniedUsers": { "$ref": "#/$defs/maybeclawIdentityList" },
        "allowedAgents": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/maybeclawIdentifier" },
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/maybeclawAgentId" },
            "uniqueItems": true
          }
        }
      },
      "additionalProperties": false
    },
    "server": {
      "type": "object",
      "properties": {
        "maxConcurrent": { "type": "integer", "minimum": 1, "default": 4 },
        "auth": {
          "type": "object",
          "properties": {
            "password": {
              "type": "string",
              "minLength": 10,
              "maxLength": 1024,
              "writeOnly": true,
              "description": "Administrator password, automatically replaced with passwordHash by the running Gateway or at startup."
            },
            "passwordHash": {
              "type": "string",
              "maxLength": 512,
              "writeOnly": true,
              "description": "Generated Argon2id password hash."
            },
            "sessionMs": { "type": "integer", "minimum": 1000, "maximum": 86400000, "default": 28800000 }
          },
          "anyOf": [{ "required": ["password"] }, { "required": ["passwordHash"] }],
          "additionalProperties": false
        },
        "idleMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 600000 },
        "shutdownMs": { "type": "integer", "minimum": 0, "maximum": 2147483647, "default": 30000 },
        "approvalMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "default": 600000 },
        "publicOrigin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@\\s]+$",
          "description": "Canonical HTTPS origin of the control service behind a reverse proxy, without a path, query, fragment, or credentials."
        }
      },
      "additionalProperties": false
    },
    "channels": {
      "type": "object",
      "properties": {
        "telegram": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "botToken": {
              "$ref": "#/$defs/channelCredential",
              "description": "Literal bot token. Do not also set botTokenEnv."
            },
            "botTokenEnv": { "$ref": "#/$defs/credentialEnv", "default": "MAYBECLAW_TELEGRAM_TOKEN" },
            "allowUsers": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
              "uniqueItems": true
            },
            "allowGroups": {
              "type": "array",
              "items": { "type": "string", "pattern": "^-[1-9][0-9]{0,19}$" },
              "uniqueItems": true
            },
            "groupTrigger": { "enum": ["explicit", "all"], "default": "explicit" },
            "entranceTriggers": {
              "type": "array",
              "items": { "$ref": "#/$defs/maybeclawEntranceTrigger" },
              "uniqueItems": true
            }
          },
          "if": { "required": ["enabled"], "properties": { "enabled": { "const": true } } },
          "then": {
            "anyOf": [
              { "required": ["allowUsers"], "properties": { "allowUsers": { "minItems": 1 } } },
              { "required": ["allowGroups"], "properties": { "allowGroups": { "minItems": 1 } } }
            ]
          },
          "not": { "required": ["botToken", "botTokenEnv"] },
          "additionalProperties": false
        },
        "feishu": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "appId": { "type": "string" },
            "appSecret": {
              "$ref": "#/$defs/channelCredential",
              "description": "Literal app secret. Do not also set appSecretEnv."
            },
            "appSecretEnv": { "$ref": "#/$defs/credentialEnv", "default": "MAYBECLAW_FEISHU_SECRET" },
            "allowUsers": {
              "type": "array",
              "items": { "type": "string", "pattern": "^ou_[A-Za-z0-9_-]{1,128}$" },
              "uniqueItems": true
            },
            "allowGroups": {
              "type": "array",
              "items": { "type": "string", "pattern": "^oc_[A-Za-z0-9_-]{1,128}$" },
              "uniqueItems": true
            },
            "groupTrigger": { "enum": ["explicit", "all"], "default": "explicit" },
            "entranceTriggers": {
              "type": "array",
              "items": { "$ref": "#/$defs/maybeclawEntranceTrigger" },
              "uniqueItems": true
            }
          },
          "if": { "required": ["enabled"], "properties": { "enabled": { "const": true } } },
          "then": {
            "required": ["appId"],
            "properties": { "appId": { "pattern": "^cli_[0-9a-fA-F]{16}$" } },
            "anyOf": [
              { "required": ["allowUsers"], "properties": { "allowUsers": { "minItems": 1 } } },
              { "required": ["allowGroups"], "properties": { "allowGroups": { "minItems": 1 } } }
            ]
          },
          "not": { "required": ["appSecret", "appSecretEnv"] },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "maybeclawAgentId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$" },
    "maybeclawIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"
    },
    "maybeclawIdentityList": {
      "type": "array",
      "items": { "$ref": "#/$defs/maybeclawIdentifier" },
      "uniqueItems": true
    },
    "maybeclawIdentityLists": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/maybeclawIdentifier" },
      "additionalProperties": { "$ref": "#/$defs/maybeclawIdentityList" }
    },
    "maybeclawEntranceTrigger": {
      "type": "object",
      "required": ["conversation", "trigger"],
      "properties": {
        "conversation": { "type": "string", "minLength": 1, "maxLength": 256 },
        "threadId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "trigger": { "enum": ["explicit", "all"] }
      },
      "additionalProperties": false
    },
    "maybeclawAgent": {
      "type": "object",
      "required": ["id", "adapter"],
      "properties": {
        "requestRecording": { "enum": ["off", "required"], "default": "required" },
        "providerBodyRecording": { "type": "boolean", "default": false },
        "id": { "$ref": "#/$defs/maybeclawAgentId" },
        "name": { "$ref": "#/$defs/maybeclawIdentifier" },
        "adapter": { "enum": ["may", "module"] },
        "enabled": { "type": "boolean", "default": true },
        "model": { "$ref": "#/$defs/maybeclawIdentifier" },
        "instructions": { "type": "string" },
        "media": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["image", "audio", "file", "video"] },
          "description": "Explicit input media capabilities; video remains a file content part with a video MIME type."
        },
        "readDirectory": {
          "$ref": "#/$defs/maybeclawIdentifier",
          "description": "Absolute directory, validated using the host platform's path rules."
        },
        "module": { "$ref": "#/$defs/maybeclawIdentifier" },
        "export": { "$ref": "#/$defs/maybeclawIdentifier", "default": "createAdapter" },
        "options": { "type": "object" },
        "plugins": { "$ref": "#/$defs/pluginSelections" },
        "idleMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "runBudget": { "$ref": "#/$defs/runBudget" },
        "permissions": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/maybeclawIdentifier" },
          "additionalProperties": { "enum": ["allow", "deny", "ask"] }
        }
      },
      "if": { "properties": { "adapter": { "const": "module" } } },
      "then": {
        "required": ["module"],
        "not": {
          "anyOf": [
            { "required": ["plugins"] },
            { "required": ["requestRecording"] },
            { "required": ["providerBodyRecording"] }
          ]
        }
      },
      "else": {
        "not": { "anyOf": [{ "required": ["module"] }, { "required": ["export"] }, { "required": ["options"] }] }
      },
      "additionalProperties": false
    },
    "channelCredential": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^\\S+$",
      "writeOnly": true
    },
    "credentialEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" }
  }
}
