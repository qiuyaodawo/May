{
  "name": "may",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-maybecode.mjs",
    "clean": "tsc -b --clean",
    "docs:check": "node scripts/check-docs.mjs",
    "changeset": "changeset",
    "release:status": "node scripts/check-release.mjs && changeset status",
    "release:check": "node scripts/check-release.mjs",
    "test:package:release": "node scripts/test-release-packages.mjs",
    "test": "pnpm -r --no-bail --if-present run test && pnpm run test:locks",
    "test:locks": "node --test scripts/test-file-locks.mjs",
    "test:path-alias": "node scripts/test-path-alias.mjs",
    "test:coverage": "pnpm -r --no-bail --if-present run test:coverage",
    "test:integration:deepseek": "pnpm build && node --test packages/providers/test/deepseek/integration/*.test.mjs",
    "test:integration:zhipu": "pnpm build && node --test packages/providers/test/zhipu/integration/*.test.mjs",
    "test:integration:kimi": "pnpm build && node --test packages/providers/test/kimi/integration/*.test.mjs",
    "test:integration:anthropic": "pnpm build && node --test packages/providers/test/anthropic/integration/*.test.mjs",
    "test:integration:maybecode": "pnpm --filter @sortedyuan/maybecode run test:integration",
    "test:package:maybecode": "node scripts/test-maybecode-package.mjs",
    "test:package:plugin": "node scripts/test-plugin-package.mjs",
    "test:package:scheduler": "node scripts/test-scheduler-package.mjs",
    "test:package:eval": "node scripts/test-eval-package.mjs",
    "test:integration:eval": "pnpm build && node scripts/test-eval-agent.mjs",
    "test:integration:scheduler": "pnpm build && node scripts/test-scheduler-agent.mjs",
    "test:integration:model-telemetry": "pnpm build && node scripts/test-model-telemetry-live.mjs",
    "may": "pnpm run build && node apps/cli/dist/bin.js",
    "eval": "pnpm --filter @sortedyuan/eval-cli run build && node apps/eval/dist/bin.js",
    "maybecode": "pnpm run build && node apps/maybecode/dist/bin.js",
    "maybeclaw": "pnpm run build && node apps/maybeclaw/dist/bin.js",
    "example": "pnpm run build && pnpm --filter @sortedyuan/example-basic run start",
    "example:deepseek": "pnpm run build && pnpm --filter @sortedyuan/example-deepseek run start",
    "example:web-ui": "pnpm run build && pnpm --filter @sortedyuan/example-web-ui start"
  },
  "devDependencies": {
    "@sortedyuan/may": "workspace:*",
    "@sortedyuan/providers": "workspace:*",
    "@sortedyuan/observability": "workspace:*",
    "@sortedyuan/coding-tools": "workspace:*",
    "@changesets/cli": "3.0.3",
    "esbuild": "^0.28.2",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "typescript": "^7.0.2"
  }
}
