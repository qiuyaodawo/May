{
  "name": "may",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "test:integration:deepseek": "pnpm --filter @may/provider-deepseek run test:integration",
    "test:integration:zhipu": "pnpm --filter @may/provider-zhipu run test:integration",
    "test:integration:kimi": "pnpm --filter @may/provider-kimi run test:integration",
    "test:integration:anthropic": "pnpm --filter @may/provider-anthropic run test:integration",
    "test:integration:maybecode": "pnpm --filter @may/maybecode run test:integration",
    "may": "pnpm run build && node apps/cli/dist/bin.js",
    "maybecode": "pnpm run build && node apps/maybecode/dist/bin.js",
    "example": "pnpm run build && pnpm --filter @may/example-basic run start",
    "example:deepseek": "pnpm run build && pnpm --filter @may/example-deepseek run start"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
